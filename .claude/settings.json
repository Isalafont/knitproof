{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(uv run pytest *)",
      "Bash(uv run --locked pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run --locked ruff *)",
      "Bash(uv run lint-imports *)",
      "Bash(uv run --locked lint-imports *)",
      "Bash(uv run mypy *)",
      "Bash(uv run --locked mypy *)",
      "Bash(uv run --locked pre-commit run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -d *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git rebase *)",
      "Bash(git push -u origin feature/*)",
      "Bash(gh pr create --base develop *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-tree *)",
      "Bash(git worktree list *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(ln -s */.claude/plans */.claude/plans)",
      "Bash(git push --force-with-lease origin feature/*)",
      "Bash(herdr pane split *)",
      "Bash(herdr pane layout *)",
      "Bash(herdr pane close *)",
      "Bash(herdr agent list)",
      "Bash(herdr agent read *)",
      "Bash(herdr agent start cla-* *)",
      "Bash(herdr agent prompt cla-* *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add . *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease=*)",
      "Bash(git push --force-with-lease * develop)",
      "Bash(git push --force-with-lease * develop *)",
      "Bash(git push --force-with-lease * main)",
      "Bash(git push --force-with-lease * main *)",
      "Bash(git push --force-with-lease *:develop)",
      "Bash(git push --force-with-lease *:develop *)",
      "Bash(git push --force-with-lease *:main)",
      "Bash(git push --force-with-lease *:main *)",
      "Bash(git push --force-with-lease *refs/heads/*)",
      "Bash(git push * +*)",
      "Bash(git worktree remove * --force *)",
      "Bash(git worktree remove --force *)",
      "Bash(git worktree remove * -f *)",
      "Bash(git worktree remove -f *)",
      "Bash(git worktree remove * --force)",
      "Bash(git worktree remove * -f)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)"
    ]
  }
}
