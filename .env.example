# Copier en .env et remplir. Ne jamais commiter .env.
# Clé Ravelry en lecture seule (Basic Auth) : https://www.ravelry.com/pro/developer
RAVELRY_USERNAME=
RAVELRY_PASSWORD=

# Modèles (CLA-127, ADR 0033) : identifiants figés, jamais « -latest ».
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
KNITPROOF_ANTHROPIC_MODEL=
KNITPROOF_MISTRAL_MODEL=
KNITPROOF_ANTHROPIC_BASE_URL=
KNITPROOF_MISTRAL_BASE_URL=
KNITPROOF_LLM_TEMPERATURE=
KNITPROOF_LLM_RETRIES=
