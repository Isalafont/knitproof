# Copier en .env et remplir. Ne jamais commiter .env.
# Clé Ravelry en lecture seule (Basic Auth) : https://www.ravelry.com/pro/developer
RAVELRY_USERNAME=
RAVELRY_PASSWORD=

# Modèles (CLA-127, CLA-62 ; Anthropic, Mistral, OpenAI, OpenRouter, Ollama local ; ADR 0033) : identifiants figés, jamais « -latest ».
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
KNITPROOF_ANTHROPIC_MODEL=
KNITPROOF_MISTRAL_MODEL=
KNITPROOF_OPENAI_MODEL=
KNITPROOF_OPENROUTER_MODEL=
KNITPROOF_OPENROUTER_HOST=
KNITPROOF_OLLAMA_MODEL=
KNITPROOF_OLLAMA_BASE_URL=
KNITPROOF_ANTHROPIC_BASE_URL=
KNITPROOF_MISTRAL_BASE_URL=
KNITPROOF_OPENAI_BASE_URL=
KNITPROOF_LLM_TEMPERATURE=
KNITPROOF_LLM_RETRIES=
