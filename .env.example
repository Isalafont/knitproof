# Copier en .env et remplir. Ne jamais commiter .env.
# Clé Ravelry en lecture seule (Basic Auth) : https://www.ravelry.com/pro/developer
RAVELRY_USERNAME=
RAVELRY_PASSWORD=

# Modèles (CLA-127, CLA-62 ; Anthropic, Mistral, OpenAI, OpenRouter, Kimi (Moonshot AI), Ollama local ; ADR 0033 et 0034) : identifiants figés, jamais « -latest ».
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MOONSHOTAI_API_KEY=
KNITPROOF_ANTHROPIC_MODEL=
KNITPROOF_MISTRAL_MODEL=
KNITPROOF_OPENAI_MODEL=
KNITPROOF_OPENROUTER_MODEL=
KNITPROOF_OPENROUTER_HOST=
KNITPROOF_MOONSHOTAI_MODEL=
KNITPROOF_MOONSHOTAI_BASE_URL=
KNITPROOF_OLLAMA_MODEL=
KNITPROOF_OLLAMA_BASE_URL=
KNITPROOF_ANTHROPIC_BASE_URL=
KNITPROOF_MISTRAL_BASE_URL=
KNITPROOF_OPENAI_BASE_URL=
KNITPROOF_LLM_TEMPERATURE=
# Température par fournisseur (CLA-188) : prime sur la globale ; `omit` n’en envoie aucune
# (Sonnet 5.5, Kimi). `knitproof eval` exige 0 ou omit pour chaque fournisseur.
KNITPROOF_ANTHROPIC_TEMPERATURE=
KNITPROOF_MISTRAL_TEMPERATURE=
KNITPROOF_OPENAI_TEMPERATURE=
KNITPROOF_OPENROUTER_TEMPERATURE=
KNITPROOF_MOONSHOTAI_TEMPERATURE=
KNITPROOF_OLLAMA_TEMPERATURE=
KNITPROOF_LLM_RETRIES=
KNITPROOF_LLM_HTTP_RETRIES=
KNITPROOF_LLM_HTTP_WAIT=
